# Copy to .env and load with `node --env-file=.env bin/launch-relay.js ...`
# Nothing here belongs in launch-relay.config.json: the config file is meant to
# be committed, and none of these values are.

# Arms this machine for --live. Without it, every command is a dry run.
LAUNCH_RELAY_ARMED=0

# EVM wallet pool. Use ONE of these two.
# A seed phrase derives as many wallets as `wallets.count` in the config, which
# is the easiest way to run "from different wallets" with one thing to back up.
LAUNCH_RELAY_MNEMONIC=
# Or bring existing funded keys, comma-separated, with or without the 0x prefix.
LAUNCH_RELAY_EVM_KEYS=

# Solana wallet pool, for the pump.fun target. Base58 secret keys, comma-separated.
LAUNCH_RELAY_SOLANA_KEYS=

# Optional RPC overrides. The defaults are public endpoints, which are fine for
# reading and unreliable for landing transactions under load.
LAUNCH_RELAY_RPC_URL=
LAUNCH_RELAY_SOLANA_RPC_URL=

# Verbose logging.
LAUNCH_RELAY_DEBUG=
